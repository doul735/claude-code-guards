{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-start-not-offer.cjs\"" },
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-no-plan-flip.cjs\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Monitor|Bash",
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/block-subagent-nesting.cjs\"" }
        ]
      }
    ]
  }
}
